# =============================================================================
# CodeIgniter 4
# =============================================================================
/.env
/.env.*
!/.env.example
/env
/phpunit.xml
/.env.ferozo.bak.*

# =============================================================================
# Credenciales locales (NO COMMITEAR)
# =============================================================================
/.ferozo-credentials*
/ferozo-credentials*
/vendor/
/writable/cache/*
!/writable/cache/index.html
!/writable/cache/.gitkeep
/writable/logs/*
!/writable/logs/index.html
!/writable/logs/.gitkeep
/writable/session/*
!/writable/session/index.html
!/writable/session/.gitkeep
/writable/uploads/*
!/writable/uploads/index.html
!/writable/uploads/.gitkeep
/writable/debugbar/*
!/writable/debugbar/index.html
!/writable/debugbar/.gitkeep
/writable/_diag_backup/

# =============================================================================
# PHP y herramientas
# =============================================================================
*.log
*.pid
*.seed
*.pid.lock
composer.phar
.phpunit.result.cache
.phpunit.cache/
/build/
__pycache__/
*.py[cod]

# =============================================================================
# IDEs
# =============================================================================
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# =============================================================================
# Sistema operativo
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# =============================================================================
# Deploys y backups
# =============================================================================
/deploy_*/
/backup_*/
*.tar.gz
*.zip
*.bak

# =============================================================================
# Adjuntos privados
# =============================================================================
# Si por la configuración del hosting la ruta privada vive dentro del repo,
# mantenerla ignorada por defecto.
/private/
/storage/adjuntos/

# Builds locales de deploy (zips para subir por FTP)
/dist/

# Artefactos locales de deploy: copias de stage, respaldos de produccion con
# sus SHA256 e inventarios FTPS. Nunca deben versionarse.
/.deploy/

# =============================================================================
# Artefactos de scraping y debugging manual
# =============================================================================
# Cookies exportadas y paginas capturadas durante pruebas con curl/Invoke-WebRequest
# o sesiones de Playwright. Son temporales, no parte del codigo.
/cookies*.txt
/superadmin.html

# Artefactos de Playwright y testing
/.playwright-cli/
/_internal/
/output/
/remote-manifest-before-*.json
/tmp/
/test_temp.log

# =============================================================================
# Datos reales y artefactos de analisis (NO COMMITEAR)
# =============================================================================
# Dump de PostgreSQL del ERP de transporte (pg_dump -Ft, 10 MB): contiene datos
# reales de viajes, clientes y flota de la empresa. Se usa para analizar y
# migrar, nunca se versiona.
docs/*.backup
# Dumps e inventarios de base: en este repo solo interesa el analisis escrito
# en docs/, no el dump.
docs/ddl_backup_*.sql
docs/inventario_backup_*.sql
docs/inventario_backup_*.csv
# Archivos temporales de bloqueo de Office (~$archivo.docx).
docs/~$*
# Logs locales de la aplicacion.
/logs/
# Prototipos de previsualizacion de telemetria, fuera de frontend/src.
frontend/TelemetryPreview.vue
frontend/telemetry-preview.html
frontend/telemetry-preview.js
