# ----------------------------------------------------------------------
# CodeIgniter 4 - htaccess minimalista para Ferozo
# ----------------------------------------------------------------------
# Sin directivas `Options` (Ferozo a veces no las permite y tira 500).
# Sin regla de "forzar HTTPS" (Ferozo ya lo hace en el panel, y la regla
# RewriteRule con %{HTTP_HOST} pierde el path cuando hay un proxy).
# Solo RewriteEngine + redirect a index.php + proteccion del .env.
# ----------------------------------------------------------------------

RewriteEngine On

# Colision ruta virtual / directorio fisico.
# El webroot de Ferozo tiene un directorio real llamado `mantenimiento` (vacio,
# sobrante de un despliegue antiguo). La regla generica de mas abajo solo reescribe
# a index.php cuando el destino NO es un archivo NI un directorio, asi que
# /mantenimiento caia en el manejo de directorios de Apache y devolvia su 403
# generico sin llegar nunca a CodeIgniter: el permiso del usuario era irrelevante.
#
# Esta regla tiene que ir ANTES de la regla generica, y no abre ningun hueco:
#   - no solapa con el bloqueo de codigo fuente de la regla siguiente, porque
#     `mantenimiento` no es uno de los directorios bloqueados;
#   - no afecta a assets ni estaticos, que viven en /assets y no bajo
#     /mantenimiento;
#   - la proteccion de .env es un bloque <Files> aparte y sigue aplicando;
#   - la autenticacion y los permisos los decide la app al llegar a index.php.
RewriteRule ^mantenimiento(?:/.*)?$ index.php [L,NC]

# El despliegue usa una raiz publica plana. Estos directorios contienen
# codigo fuente, dependencias, pruebas o archivos operativos y nunca deben
# responderse como contenido estatico.
RewriteRule ^(?:app|docs|frontend|home|scripts|tests|vendor|writable)(?:/|$) - [F,L,NC]

# Redirigir trailing slashes (excepto la raiz)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [L,R=301]

# Reescribir a index.php si la URL no es un archivo ni un directorio real
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# Bloquear acceso directo al .env
<Files ".env">
    Order allow,deny
    Deny from all
</Files>
