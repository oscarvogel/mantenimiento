# =============================================================================
# Sistema de Gestion de Mantenimiento - Configuracion de entorno
# =============================================================================
# Copiar este archivo a .env y completar con los valores reales del despliegue.
# .env NO debe versionarse.
#
# Sobre la baseURL: la URL canonica del sistema es
# https://vogelconsultoria.com.ar/mantenimiento/. El archivo app/Config/App.php
# detecta la URL base a partir de $_SERVER, asi que el sistema funciona tanto
# si se accede por esa URL como si en el futuro se muda a otra ruta o
# subdominio: solo hay que cambiar donde apunta el webroot.
# Si se quiere fijar, descomentar app.baseURL con la URL completa.
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno
# -----------------------------------------------------------------------------
CI_ENVIRONMENT = development

# -----------------------------------------------------------------------------
# Aplicacion
# -----------------------------------------------------------------------------
# Base URL: en Ferozo la autodeteccion de baseURL a partir de SCRIPT_NAME
# funciona bien para el subdirectorio /mantenimiento/. Si se deploya en
# otro hosting o en una ruta distinta, se puede fijar aca la URL completa.
app.baseURL = ''
app.forceGlobalSecureRequests = false
app.CSPEnabled = false
# app.defaultLocale = 'es'
# app.appTimezone = 'America/Argentina/Buenos_Aires'
# app.indexPage = ''   (vacio, no usar index.php en las URLs)

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = mantenimiento
database.default.username = mantenimiento
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port     = 3306

# -----------------------------------------------------------------------------
# Correo (SMTP autenticado)
# -----------------------------------------------------------------------------
email.protocol      = smtp
email.SMTPHost      = smtp.example.com
email.SMTPUser      = alertas@example.com
email.SMTPPass      =
email.SMTPPort      = 587
email.SMTPCrypto    = tls
email.mailType      = html
email.charset       = UTF-8
email.fromEmail     = 'alertas@example.com'
email.fromName      = 'Mantenimiento'
email.bccDefault    = 'operaciones@example.com'

# -----------------------------------------------------------------------------
# Sesion
# -----------------------------------------------------------------------------
session.driver     = 'CodeIgniter\Session\Handlers\FileHandler'
session.expiration  = 1800

# -----------------------------------------------------------------------------
# Alertas y procesos programados
# -----------------------------------------------------------------------------
alerts.dailyRunTime          = '07:00'
alerts.defaultAnticipationDays = 15
alerts.lecturasVencidasDias  = 30
alerts.ordenDemoradaDias     = 5
alerts.lockTimeoutSeconds    = 900
alerts.smtpMaxRetries        = 3
alerts.smtpRetryBackoff      = 60

# Endpoint seguro para Ferozo cuando no existe PHP CLI. Generar un secreto de al
# menos 32 caracteres y enviarlo mediante el header X-Cron-Token.
# Mantener deshabilitado hasta que el token real esté cargado en el .env.
alerts.webCronEnabled        = false
alerts.webCronToken          =
alerts.webCronRateLimit      = 6
alerts.webCronRateWindowSeconds = 60

# -----------------------------------------------------------------------------
# Web Push / PWA
# -----------------------------------------------------------------------------
webpush.enabled         = false
webpush.vapidPublicKey  =
webpush.vapidPrivateKey =
webpush.subject         = 'mailto:alertas@example.com'

# -----------------------------------------------------------------------------
# Migracion remota (helper de deploy en Ferozo sin SSH)
# -----------------------------------------------------------------------------
MIGRATE_TOKEN =

# -----------------------------------------------------------------------------
# Adjuntos y archivos privados
# -----------------------------------------------------------------------------
uploads.privatePath = '/home/mantenimiento/adjuntos'
uploads.maxSizeMB   = 10
uploads.allowedExt  = 'pdf,jpg,jpeg,png,webp'
uploads.primaryPhotoMaxSizeMB = 5
imports.privatePath = '/home/mantenimiento/importaciones'
imports.maxSizeMB   = 10

# -----------------------------------------------------------------------------
# Seguridad
# -----------------------------------------------------------------------------
encryption.key =
auth.maxLoginAttempts = 5
auth.lockoutMinutes   = 15

# -----------------------------------------------------------------------------
# Log y errores
# -----------------------------------------------------------------------------
logger.threshold = 4

# -----------------------------------------------------------------------------
# IA / MiniMax
# -----------------------------------------------------------------------------
# La misma API key se reutiliza para chatbot e importación documental.
# Nunca guardar la clave real en el repositorio.
ai.enabled = false
ai.provider = minimax
ai.apiKey =
ai.model = MiniMax-M3
ai.timeoutSeconds = 30
ai.contextWindowMessages = 20
ai.rateLimitPerMinute = 60

# Análisis de órdenes de taller desde JPG/PNG/PDF.
# El endpoint queda configurable para no acoplar el dominio al proveedor.
ai.documentModel = MiniMax-M3
ai.documentVisionUrl = 'https://api.minimax.io/v1/chat/completions'
ai.documentTimeoutSeconds = 60
# Para PDF el servidor PHP necesita Imagick para rasterizar la primera página.
